# Copie ce fichier en .env (non versionné) et adapte-le.

# URL ntfy qui reçoit les messages du formulaire de contact (vide = formulaire désactivé)
NOTIFICATIONS_URL=
# URL publique du site (lien cliquable dans la notification)
SITE_URL=https://exemple.fr

# Nombre de reverse proxys devant l'app (Nginx = 1) pour lire la vraie IP des visiteurs
TRUSTED_PROXIES=1

# Anti-spam du formulaire : 5 messages / 10 min / IP
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=600

# ── Connexion (optionnelle) : laisser vide = site 100 % public ──
# Doc : docs/liaison-des-repos.md
# Test en local (3 repos lancés sur 5000 / 5001 / 5002) :
AUTH_PUBLIC_URL=
#AUTH_PUBLIC_URL=http://localhost:5000
APP_URL=
#APP_URL=http://localhost:5001/
# Adresse d'auth vue depuis le conteneur (réseau Docker « web »). Vide = AUTH_PUBLIC_URL.
AUTH_INTERNAL_URL=
#AUTH_INTERNAL_URL=http://auth:5000
# Nom du cookie de session d'auth (Flask : « session » par défaut)
AUTH_COOKIE_NAME=session
